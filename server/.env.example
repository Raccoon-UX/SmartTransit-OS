# ==========================================
# SmartTransit OS Backend Configuration Template
# ==========================================

# Server Port
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection URI (Atlas / Local)
MONGODB_URI=mongodb://127.0.0.1:27017/smarttransit_os

# CORS Allowed Origin (Never use * in production)
CORS_ORIGIN=http://localhost:5173

# JWT Secret & Expiry Configuration (Reserved for Phase 4)
JWT_SECRET=replace_with_a_secure_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
